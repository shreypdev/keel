+//! PROTO(ADR-058): generic functions with an instantiation list, generic objects and generic
+//! stores instantiated through an alias, run against the real runtime. Not for landing: it proves
+//! the mechanism the ADR decides on.
+#![forbid(unsafe_code)]
+
+use std::any::Any;
+use std::sync::{Arc, Mutex};
+
+use undra::meta::{Schema, TypeRef, collect_schema, ids};
+use undra::prelude::{Computed, Ctx, Signal};
+use undra::runtime::{StoreObject, StoreRestorer};
+use undra::signals::StoreCell;
+use undra::wire::payload::ChangeOp;
+use undra::wire::{Decode, Encode, Handle, KeyedPatch, PatchOp, Reader, Writer};
+use undra_macros as k;
+
+mod support;
+use support::Runtime;
+
+fn schema() -> Schema {
+    collect_schema("proto-generics")
+}
+
+fn named(name: &str) -> TypeRef {
+    TypeRef::Named(name.to_owned())
+}
+
+#[k::api]
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Todo {
+    pub id: u32,
+    pub title: String,
+}
+
+#[k::api]
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Note {
+    pub id: u32,
+    pub body: String,
+}
+
+/// What the generic code below needs of a row: plain Rust, invisible to the schema.
+pub trait Row: undra::signals::SignalValue + Default {
+    fn id(&self) -> u32;
+    fn with_id(id: u32) -> Self;
+}
+
+impl Row for Todo {
+    fn id(&self) -> u32 {
+        self.id
+    }
+    fn with_id(id: u32) -> Self {
+        Todo {
+            id,
+            title: format!("todo {id}"),
+        }
+    }
+}
+
+impl Row for Note {
+    fn id(&self) -> u32 {
+        self.id
+    }
+    fn with_id(id: u32) -> Self {
+        Note {
+            id,
+            body: format!("note {id}"),
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generic functions
+// ---------------------------------------------------------------------------------------------
+
+/// The row with the highest id.
+#[k::api(generic(T = [Todo, Note]))]
+pub fn newest<T: Row>(items: Vec<T>) -> Option<T> {
+    items.into_iter().max_by_key(Row::id)
+}
+
+#[k::error]
+#[derive(PartialEq)]
+pub enum LoadError {
+    #[error("no row {0}")]
+    Missing(u32),
+}
+
+/// Loads a row: `T` stands in the return type only, the function is `async` and takes the context.
+#[k::api(generic(T = [Todo, Note]))]
+pub async fn load<T: Row>(ctx: &Ctx, id: u32) -> Result<T, LoadError> {
+    let _ = ctx;
+    if id == 0 {
+        Err(LoadError::Missing(id))
+    } else {
+        Ok(T::with_id(id))
+    }
+}
+
+#[test]
+fn a_generic_function_registers_one_function_per_instantiation() {
+    let schema = schema();
+    let names: Vec<&str> = schema.functions.iter().map(|f| f.name.as_str()).collect();
+    for name in ["newest<Todo>", "newest<Note>", "load<Todo>", "load<Note>"] {
+        assert!(names.contains(&name), "{names:?}");
+    }
+    let f = schema
+        .functions
+        .iter()
+        .find(|f| f.name == "newest<Todo>")
+        .unwrap();
+    assert_eq!(f.method_id, ids::function_id("newest<Todo>"));
+    assert_eq!(f.params[0].ty, TypeRef::vec(named("Todo")));
+    assert_eq!(f.returns, TypeRef::option(named("Todo")));
+    assert_eq!(f.docs, "The row with the highest id.");
+    let g = schema
+        .functions
+        .iter()
+        .find(|f| f.name == "load<Note>")
+        .unwrap();
+    assert!(g.is_async && g.takes_ctx);
+    assert_eq!(g.returns, TypeRef::result(named("Note"), named("LoadError")));
+    schema.validate().unwrap();
+}
+
+#[test]
+fn each_instantiation_dispatches_to_the_generic_function() {
+    let rt = Runtime::new();
+    let mut w = Writer::new();
+    vec![Todo::with_id(2), Todo::with_id(7), Todo::with_id(3)].encode(&mut w);
+    let reply = rt.call_function("newest<Todo>", w.as_slice()).sync_ok();
+    assert_eq!(
+        Option::<Todo>::decode_exact(&reply).unwrap(),
+        Some(Todo::with_id(7))
+    );
+
+    let mut w = Writer::new();
+    vec![Note::with_id(5)].encode(&mut w);
+    let reply = rt.call_function("newest<Note>", w.as_slice()).sync_ok();
+    assert_eq!(
+        Option::<Note>::decode_exact(&reply).unwrap(),
+        Some(Note::with_id(5))
+    );
+
+    let mut w = Writer::new();
+    9_u32.encode(&mut w);
+    let reply = rt
+        .call_function("load<Note>", w.as_slice())
+        .run_async()
+        .unwrap();
+    assert_eq!(Note::decode_exact(&reply).unwrap(), Note::with_id(9));
+    let mut w = Writer::new();
+    0_u32.encode(&mut w);
+    let error = rt
+        .call_function("load<Todo>", w.as_slice())
+        .run_async()
+        .unwrap_err();
+    assert_eq!(
+        LoadError::decode_exact(&error).unwrap(),
+        LoadError::Missing(0)
+    );
+}
