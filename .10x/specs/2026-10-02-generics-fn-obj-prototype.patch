+/// PROTO(ADR-058): the exported template of a generic object or store.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn object_template(
+    root_path: &str,
+    name: &str,
+    params: &[String],
+    kind: &str,
+    docs: &str,
+    impl_docs: &str,
+    restore: &str,
+    definitions: TokenStream,
+) -> TokenStream {
+    let mut replacements: HashMap<String, TokenStream> = HashMap::new();
+    replacements.insert(ALIAS.to_owned(), quote!($__alias));
+    let mut matchers = Vec::new();
+    for param in params {
+        let metavariable = format_ident!("{}", param);
+        replacements.insert(param_placeholder(param), quote!($#metavariable));
+        matchers.push(quote!($#metavariable:ty));
+    }
+    let definitions = replace_idents(definitions, &replacements);
+    let macro_name = template_macro_name(name);
+    let type_name = format_ident!("{}", name);
+    let root: syn::Path = syn::parse_str(root_path).expect("a root path");
+    let crate_name = std::env::var("CARGO_CRATE_NAME").unwrap_or_default();
+    quote! {
+        #[doc(hidden)]
+        #[macro_export]
+        macro_rules! #macro_name {
+            ( $__alias:ident, $__docs:literal, #(#matchers),* ) => {
+                #root::__instantiate! {
+                    #[undra_instance(
+                        kind = #kind,
+                        template = #name,
+                        crate_name = #crate_name,
+                        root = #root_path,
+                        docs = #docs,
+                        impl_docs = #impl_docs,
+                        restore = #restore,
+                        alias_docs = $__docs
+                    )]
+                    #definitions
+                }
+            };
+        }
+
+        #[doc(hidden)]
+        #[allow(unused_imports, unreachable_pub)]
+        pub use #macro_name as #type_name;
+    }
+}
