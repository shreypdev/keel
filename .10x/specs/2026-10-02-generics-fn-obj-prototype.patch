+    // The persisted identity of each instantiation is its own (ADR-037).
+    let a = schema.store_fingerprint(ids::type_id("TodoSelection"));
+    let b = schema.store_fingerprint(ids::type_id("NoteSelection"));
+    assert!(a.is_some() && b.is_some());
+    assert_ne!(a, b);
+    schema.validate().unwrap();
+}
+
+#[test]
+fn a_generic_store_delivers_keyed_patches_and_restores() {
+    let rt = Runtime::new();
+    let mut w = Writer::new();
+    3_u32.encode(&mut w);
+    let handle = construct(&rt, "TodoSelection", w.as_slice());
+    let store: Arc<Selection<Todo>> = rt.object::<TodoSelection>(handle).unwrap();
+    assert_eq!(StoreCell::type_id(store.cell()), ids::type_id("TodoSelection"));
+    assert_eq!(store.cell().handle(), handle);
+    assert_eq!(store.cell().signal_count(), 3);
+
+    rt.real().observe(handle, 0, true);
+    rt.change_sets();
+    for id in [1_u32, 2] {
+        let mut w = Writer::new();
+        Todo::with_id(id).encode(&mut w);
+        rt.call_object("TodoSelection", "toggle", handle, w.as_slice())
+            .sync_ok();
+    }
+    let sets = rt.change_sets();
+    let entry = &sets.last().unwrap().entries[0];
+    assert_eq!(entry.op, ChangeOp::KeyedPatch);
+    let patch = KeyedPatch::<Todo>::decode(&mut Reader::new(&entry.value)).unwrap();
+    assert_eq!(
+        patch.ops,
+        vec![PatchOp::Insert {
+            index: 1,
+            item: Todo::with_id(2)
+        }]
+    );
+    assert_eq!(store.count.get(), 2);
+
+    // Restore: the registered restorer of the instantiation rebuilds `Selection<Todo>`.
+    let mut record = Writer::new();
+    store.cell().encode_snapshot(&mut record);
+    let mut r = Reader::new(record.as_slice());
+    r.read_u64().unwrap();
+    r.read_u32().unwrap();
+    let body = r.read_rest().to_vec();
+    let restorer = undra::meta::inventory::iter::<StoreRestorer>
+        .into_iter()
+        .find(|r| r.type_id == ids::type_id("TodoSelection"))
+        .expect("a restorer per instantiation");
+    let any: Arc<dyn Any + Send + Sync> =
+        (restorer.restore)(rt.ctx(), 0x0000_0002_0000_0007, &mut Reader::new(&body)).unwrap();
+    let restored = any.downcast::<Selection<Todo>>().expect("the instantiation");
+    assert_eq!(restored.items.get(), store.items.get());
+    assert_eq!(restored.limit.get(), 3);
+    assert_eq!(restored.count.get(), 2, "the hook rebuilt the computed");
+    assert_eq!(restored.label, "selection");
+
+    // The other instantiation is another store type.
+    let mut w = Writer::new();
+    1_u32.encode(&mut w);
+    let notes = construct(&rt, "NoteSelection", w.as_slice());
+    let mut w = Writer::new();
+    Note::with_id(8).encode(&mut w);
+    rt.call_object("NoteSelection", "toggle", notes, w.as_slice())
+        .sync_ok();
+    let reply = rt
+        .call_object("NoteSelection", "first", notes, &[])
+        .sync_ok();
+    assert_eq!(
+        Option::<Note>::decode_exact(&reply).unwrap(),
+        Some(Note::with_id(8))
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// The name of a generic application reached by substitution (`Page<T>` with `T = Todo`)
+// ---------------------------------------------------------------------------------------------
+
+/// A page of rows.
+#[k::api(generic)]
+#[derive(Clone, Debug, PartialEq)]
+pub struct Page<T> {
+    pub items: Vec<T>,
+    pub next: Option<String>,
+}
+
+#[k::api]
+pub type TodoPage = Page<Todo>;
+
+// What the instantiation of ADR-058 adds next to `UNDRA_TYPE_ID`.
+impl Page<Todo> {
+    pub const UNDRA_TYPE_NAME: &'static str = "TodoPage";
+}
+
+#[allow(dead_code)]
+trait NameFallback {
+    const UNDRA_TYPE_NAME: &'static str = "";
+}
+impl<T: ?Sized> NameFallback for T {}
+
+// The schema type of `Page<Todo>` in a signature the macro reached by substituting `T`: the name
+// comes from the type, not from the tokens.
+static PAGE_OF_TODO: undra::meta::TypeRefMeta =
+    undra::meta::TypeRefMeta::Named(<Page<Todo>>::UNDRA_TYPE_NAME);
+const PAGE_OF_NOTE: &str = <Page<Note>>::UNDRA_TYPE_NAME;
+
+#[test]
+fn a_generic_application_is_named_by_its_alias_through_the_type() {
+    assert_eq!(TypeRef::from(&PAGE_OF_TODO), named("TodoPage"));
+    assert_eq!(PAGE_OF_NOTE, "", "no alias: the fallback, which a const assertion turns into E0002");
+}
diff --git a/crates/undra-macros/tests/proto_scope.rs b/crates/undra-macros/tests/proto_scope.rs
new file mode 100644
index 0000000..b3c1970
--- /dev/null
+++ b/crates/undra-macros/tests/proto_scope.rs
@@ -0,0 +1,54 @@
+#![forbid(unsafe_code)]
+use std::sync::{Arc, Mutex};
+use undra::meta::{TypeRef, collect_schema};
+use undra::wire::{Decode, Encode, Handle, Writer};
+use undra_macros as k;
+
+mod support;
+use support::Runtime;
+
+#[k::api]
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Todo { pub id: u32 }
+
+pub struct Cache<T> { pub(crate) items: Mutex<Vec<T>> }
+
+#[k::api(generic)]
+impl<T: Clone + Send + Sync + 'static> Cache<T> {
+    pub fn new() -> Self { Cache { items: Mutex::new(Vec::new()) } }
+    pub fn put(&self, item: T) { self.items.lock().unwrap().push(item); }
+    pub fn len(&self) -> u32 { self.items.lock().unwrap().len() as u32 }
+}
+
+#[k::api]
+pub type TodoCache = Cache<Todo>;
+
+/// A function that hands out and takes the instantiation by its alias (ADR-040 positions).
+#[k::api]
+pub fn open_cache() -> Arc<TodoCache> { Arc::new(Cache { items: Mutex::new(vec![Todo { id: 1 }]) }) }
+
+#[k::api]
+pub fn cache_len(cache: &TodoCache) -> u32 { cache.len() }
+
+#[test]
+fn an_instantiation_stands_where_an_object_stands() {
+    let schema = collect_schema("proto-scope");
+    let open = schema.functions.iter().find(|f| f.name == "open_cache").unwrap();
+    assert_eq!(open.returns, TypeRef::Object("TodoCache".to_owned()));
+    let len = schema.functions.iter().find(|f| f.name == "cache_len").unwrap();
+    assert_eq!(len.params[0].ty, TypeRef::Object("TodoCache".to_owned()));
+    let cache = schema.objects.iter().find(|o| o.name == "TodoCache").unwrap();
+    assert_eq!(cache.methods.len(), 2);
+    schema.validate().unwrap();
+
+    let rt = Runtime::new();
+    let reply = rt.call_function("open_cache", &[]).sync_ok();
+    let handle = Handle::decode_exact(&reply).unwrap();
+    let mut w = Writer::new();
+    handle.encode(&mut w);
+    let reply = rt.call_function("cache_len", w.as_slice()).sync_ok();
+    assert_eq!(u32::decode_exact(&reply).unwrap(), 1);
+    let again = rt.call_function("open_cache", &[]).sync_ok();
+    assert_ne!(Handle::decode_exact(&again).unwrap(), handle, "a new Arc each time");
+    assert!(rt.object::<TodoCache>(handle.0).is_ok());
+}
