+/// PROTO(ADR-058): the struct an instantiation of a generic store reads.
+pub(crate) fn struct_definition(item: &syn::ItemStruct, params: &[String]) -> TokenStream {
+    let wanted: BTreeSet<String> = params.iter().cloned().collect();
+    let mut definition = item.clone();
+    definition.attrs.clear();
+    definition.ident = format_ident!("{}", ALIAS);
+    definition.generics = syn::Generics::default();
+    let mut definition = syn::Item::Struct(definition);
+    KeepReadable.visit_item_mut(&mut definition);
+    Substitute { params: &wanted }.visit_item_mut(&mut definition);
+    definition.to_token_stream()
+}
