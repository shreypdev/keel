+/// PROTO(ADR-058): `#[undra::store(generic)]` on a struct with type parameters: the struct (with
+/// its hidden cell field) and the local macro through which its `#[undra::api(store, generic)]`
+/// impl block, declared below it in the same module, hands over its signatures; the two halves
+/// become one exported template (`undra::__compose_store!`). Nothing is registered.
+pub(crate) fn expand_store_template(
+    args_root: Option<Root>,
+    restore_hook: Option<syn::Path>,
+    mut item: ItemStruct,
