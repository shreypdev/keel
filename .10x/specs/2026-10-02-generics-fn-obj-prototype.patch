+/// PROTO(ADR-058): the signature-only impl block an instantiation reads: `impl __UNDRA_ALIAS {
+/// pub fn toggle(&self, item: __UNDRA_PARAM_T) {} .. }`.
+pub(crate) fn impl_definition(item: &syn::ItemImpl, params: &[String]) -> TokenStream {
+    let wanted: BTreeSet<String> = params.iter().cloned().collect();
+    let fns = item.items.iter().filter_map(|it| match it {
+        syn::ImplItem::Fn(func) if matches!(func.vis, syn::Visibility::Public(_)) => {
+            let attrs = func
+                .attrs
+                .iter()
+                .filter(|a| a.path().is_ident("doc") || a.path().is_ident("undra"));
+            let sig = &func.sig;
+            Some(quote!(#(#attrs)* pub #sig {}))
+        }
+        _ => None,
+    });
+    let alias = format_ident!("{}", ALIAS);
+    let mut definition: syn::ItemImpl = syn::parse_quote!(impl #alias { #(#fns)* });
+    Substitute { params: &wanted }.visit_item_impl_mut(&mut definition);
+    definition.to_token_stream()
+}
