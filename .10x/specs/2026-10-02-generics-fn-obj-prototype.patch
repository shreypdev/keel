+// ---------------------------------------------------------------------------------------------
+// A generic store, instantiated through an alias
+// ---------------------------------------------------------------------------------------------
+
+/// What is selected.
+#[k::store(generic, restore = "Self::assemble")]
+pub struct Selection<T> {
+    /// The selected rows, keyed by a field every instantiation's row has.
+    #[undra(key = "id")]
+    items: Signal<Vec<T>>,
+    limit: Signal<u32>,
+    count: Computed<u32>,
+    label: String,
+}
+
+/// Selecting rows.
+#[k::api(store, generic)]
+impl<T: Row> Selection<T> {
+    pub fn new(limit: u32) -> Self {
+        Self::assemble(Ctx::current(), Signal::new(Vec::new()), Signal::new(limit))
+    }
+
+    fn assemble(_ctx: Ctx, items: Signal<Vec<T>>, limit: Signal<u32>) -> Self {
+        let count = Computed::new(&items, |items: &Vec<T>| items.len() as u32);
+        // No `__undra_cell` in the literal: the macro adds it inside this impl block.
+        Self {
+            items,
+            limit,
+            count,
+            label: "selection".to_owned(),
+        }
+    }
+
+    /// Selects a row, or deselects it when it is selected.
+    pub fn toggle(&self, item: T) {
+        let position = self.items.get().iter().position(|i| i.id() == item.id());
+        match position {
+            Some(index) => {
+                self.items.remove(index);
+            }
+            None => self.items.push(item),
+        }
+    }
+
+    pub fn first(&self) -> Option<T> {
+        self.items.get().first().cloned()
+    }
+}
+
+/// The selected todos.
+#[k::api]
+pub type TodoSelection = Selection<Todo>;
+
+#[k::api]
+pub type NoteSelection = Selection<Note>;
+
+#[test]
+fn a_generic_store_is_one_described_store_per_alias() {
+    let schema = schema();
