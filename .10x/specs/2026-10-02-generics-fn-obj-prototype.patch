+            ( $__impl_docs:literal { $($__block:tt)* } ) => {
+                #compose_store! {
+                    #name_str #root_path #struct_docs #restore
+                    [#(#param_idents),*]
+                    { #definition }
+                    $__impl_docs
+                    { $($__block)* }
+                }
+            };
