+    let mut attrs = item.attrs.clone();
+    let root = item_root(&mut attrs, args_root, &mut errors);
+    errors.finish()?;
+    let name_str = unraw(&item.ident);
+    let params = super::record::type_param_names(&item.generics);
+    let struct_docs = super::attrs::docs(&item.attrs);
+    let definition = super::generic::struct_definition(&item, &params);
