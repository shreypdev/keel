{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.AsyncIterable", "ESNext.Disposable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@undra/runtime/worker": ["../../runtimes/ts/@undra/runtime/src/worker.ts"],
      "@undra/runtime": ["../../runtimes/ts/@undra/runtime/src/index.ts"],
      "@playground/core": ["../../examples/playground/generated/ts/src/index.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
