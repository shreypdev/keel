# The target platforms an `undra_core` is built for besides the one it runs on. They name what the Rust toolchain resolution
# needs (a CPU and an OS); the Rust target triples they select are the `extra_target_triples` of the application's
# `rust.toolchain(..)` in MODULE.bazel.
package(default_visibility = ["//visibility:public"])

platform(
    name = "wasm32",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
)

platform(
    name = "ios_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:ios",
    ],
)

platform(
    name = "ios_sim_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:ios",
        "@apple_support//constraints:simulator",
    ],
)

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

platform(
    name = "android_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)
