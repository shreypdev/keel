# Generated by undra_source (ADR-061): the Swift runtime, from runtimes/swift/UndraRuntime. Swift 6, strict concurrency, as the
# package builds it. macOS and iOS only: it uses the system's Foundation, Network and SQLite.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The C ABI types of SPEC 6 (undra.h declares types, no function), as the module `UndraFFI` the runtime and the bindings import.
swift_interop_hint(
    name = "UndraFFI_hint",
    module_map = "_runtime/Sources/UndraFFI/include/module.modulemap",
    module_name = "UndraFFI",
)

cc_library(
    name = "UndraFFI",
    srcs = ["_runtime/Sources/UndraFFI/undra.c"],
    hdrs = [
        "_runtime/Sources/UndraFFI/include/module.modulemap",
        "_runtime/Sources/UndraFFI/include/undra.h",
    ],
    aspect_hints = [":UndraFFI_hint"],
    includes = ["_runtime/Sources/UndraFFI/include"],
)

swift_library(
    name = "runtime",
    srcs = glob(["_runtime/Sources/UndraRuntime/**/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "UndraRuntime",
    package_name = "UndraRuntime",
    deps = [":UndraFFI"],
)
