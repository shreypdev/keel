"""`undra_source`: the Undra repository as a Bazel repository, with the targets the rules default to.

Two flavours, one layout. `path` points at a checkout (the Undra repository's own example does, `path = "../.."`); `urls`
fetches a source archive. Either way the repository is a set of symlinks into the sources plus generated BUILD files, so
nothing is copied and nothing is written into a checkout:

    @undra//:sources          the Cargo workspace (crates/, Cargo.toml, Cargo.lock) every core is built against
    @undra//:cli              the `undra` command line, built from those sources (ADR-061)
    @undra//kotlin:runtime    the Kotlin runtime, from runtimes/kotlin
    @undra//ts:runtime        the TypeScript runtime, from runtimes/ts
    @undra//swift:runtime     the Swift runtime, from runtimes/swift

Each language has a package of its own, so a build that uses one never loads (or fetches the rules of) the others.
"""

_ROOT_BUILD = """# Generated by undra_source: do not edit.
load("@undra_rules//undra:cli.bzl", "undra_cli")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml", "Cargo.lock"])

filegroup(
    name = "sources",
    srcs = ["Cargo.toml", "Cargo.lock"] + glob(
        ["crates/**"],
        exclude = ["**/target/**", "**/node_modules/**"],
    ),
)

undra_cli(
    name = "cli",
    sources = [":sources"],
    workspace_manifest = "Cargo.toml",
)
"""

_UNCONFIGURED_BUILD = """# Generated by undra_source: no source was configured.
load("@undra_rules//undra:cli.bzl", "undra_cli")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml", "Cargo.lock"])

filegroup(name = "sources", srcs = [])

undra_cli(name = "cli", sources = [])
"""

# The package of each language runtime in @undra, and where its sources are below runtimes/ of the checkout.
RUNTIME_DIRS = {
    "kotlin": "kotlin/undra-runtime",
    "ts": "ts/@undra/runtime",
    "swift": "swift/UndraRuntime",
}

def _link(rctx, root, names):
    for name in names:
        source = root.get_child(name)
        if source.exists:
            rctx.symlink(source, name)

def _impl(rctx):
    if rctx.attr.path:
        root = rctx.path(str(rctx.workspace_root) + "/" + rctx.attr.path).realpath
    elif rctx.attr.urls:
        rctx.download_and_extract(
            url = rctx.attr.urls,
            output = "_archive",
            integrity = rctx.attr.integrity,
            stripPrefix = rctx.attr.strip_prefix,
        )
        root = rctx.path("_archive")
    else:
        rctx.file("BUILD.bazel", _UNCONFIGURED_BUILD)
        rctx.file("Cargo.toml", "")
        rctx.file("Cargo.lock", "")
        return

    _link(rctx, root, ["Cargo.toml", "Cargo.lock", "crates"])
    rctx.file(".bazelignore", "crates/undra-ffi/tests/fixture/target\ntarget\n")
    rctx.file("BUILD.bazel", _ROOT_BUILD)

    # One package per language runtime, each with a generated BUILD next to symlinks of the runtime's sources.
    for language, build in rctx.attr.runtimes.items():
        runtime = root.get_child("runtimes").get_child(RUNTIME_DIRS[language])
        if not runtime.exists:
            continue
        rctx.symlink(runtime, language + "/_runtime")
        rctx.file(language + "/BUILD.bazel", rctx.read(build))

undra_source = repository_rule(
    implementation = _impl,
    attrs = {
        "path": attr.string(doc = "A checkout of the Undra repository, relative to the root module or absolute."),
        "urls": attr.string_list(doc = "A source archive of the Undra repository."),
        "integrity": attr.string(doc = "The archive's Subresource Integrity (`sha256-..`)."),
        "strip_prefix": attr.string(doc = "The archive's top-level directory."),
        "runtimes": attr.string_keyed_label_dict(
            doc = "language package -> the file holding the BUILD file of its package.",
            allow_files = True,
        ),
    },
    local = True,
    doc = "The Undra repository, as the repository the rules build against.",
)
