# Generated by `undra`: do not edit, it is rewritten whenever the project changes.
#
# This is the library that ships to the platforms: the app core and the Undra C ABI (`undra-ffi`)
# linked into one library named after the core's namespace (`@@NAMESPACE@@`, ADR-044). `undra build`
# compiles it as a cdylib (Android, the host, the web) or a staticlib that it prelinks into one object
# (iOS); `undra bindgen` loads the host build to read the schema.
[package]
name = "undra-core-shim"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
# Per-project so a shared target directory never collides on one artifact; `undra build` copies the
# output to the core's names (`lib@@NAMESPACE@@.so`, `@@NAMESPACE@@.wasm`, ...), which are what the
# generated bindings load.
name = "@@SHIM_LIB_NAME@@"
path = "src/lib.rs"
crate-type = ["cdylib", "staticlib"]

[dependencies]
undra-ffi = @@UNDRA_FFI@@
app-core = { path = @@CORE_DIR@@, package = @@CORE_PACKAGE@@ }

[features]
# The JNI shim (Kotlin / Android, and the JVM on the host).
jni = ["undra-ffi/jni"]

# The dev profile is not incremental. This library is *loaded* by the platform runtimes with no
# link-time reference to it (a dev `undra build --platform host`, `undra bindgen`'s dlopen, the Kotlin
# runtime's `System.loadLibrary`), and the app core and undra-ffi are dependency rlibs, not this
# crate's root module. rustc links rlibs with `--start-lib` (lazy) semantics, so the macOS linker
# keeps only the objects something references -- and nothing references the core's `#[undra::api]`/
# store/port/error `inventory::submit!` statics (the schema, SPEC 2.4). An *incremental* build
# partitions those rlibs into many tiny codegen units, and the macOS linker drops the unreferenced
# ones: the core then reports the empty schema (hash 0x98754cbea76a32b2) (no `-force_load`/`-all_load`
# overrides `--start-lib`). A non-incremental build keeps them -- the same reason the release profile
# and the prelinked iOS object never showed this (ADR-029). The core's exports (`@@NAMESPACE@@_undra_api`,
# `JNI_OnLoad`) are in this crate's own root module, which is always linked (ADR-044). `undra build` compiles the host library in a target directory of its own so a
# plain `cargo build`/`cargo test` cannot leave a stripping-prone rlib for it to reuse
# (`crate::shim::host_lib_target_dir`). `undra dev` is unaffected: it serves the core from the dev
# *runner*, an executable, whose constructors always run.
[profile.dev]
incremental = false

# The profiles match the workspace's (docs/SPEC.md 7): a panic on native targets must unwind so
# the boundary can report it (constitution R6); only wasm aborts.
[profile.release]
lto = "fat"
codegen-units = 1
opt-level = 3
panic = "unwind"
strip = "symbols"
debug = false

[profile.release-wasm]
inherits = "release"
opt-level = "@@WASM_OPT_LEVEL@@"
panic = "abort"

[workspace]
