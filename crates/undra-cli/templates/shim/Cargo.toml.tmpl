# Generated by `undra`: do not edit, it is rewritten whenever the project changes.
#
# This is the library that ships to the platforms: the app core and the Undra C ABI (`undra-ffi`)
# linked into one library named after the core's namespace (`@@NAMESPACE@@`, ADR-044). `undra build`
# compiles it as a cdylib (Android, the host, the web) or a staticlib that it prelinks into one object
# (iOS); `undra bindgen` loads the host build to read the schema.
[package]
name = "undra-core-shim"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
# Per-project so a shared target directory never collides on one artifact; `undra build` copies the
# output to the core's names (`lib@@NAMESPACE@@.so`, `@@NAMESPACE@@.wasm`, ...), which are what the
# generated bindings load.
name = "@@SHIM_LIB_NAME@@"
path = "src/lib.rs"
crate-type = ["cdylib", "staticlib"]

[dependencies]
undra-ffi = @@UNDRA_FFI@@
app-core = { path = @@CORE_DIR@@, package = @@CORE_PACKAGE@@ }

[features]
# The JNI shim (Kotlin / Android, and the JVM on the host).
jni = ["undra-ffi/jni"]

# The dev profile is not incremental. This library is *loaded* by the platform runtimes with no
# link-time reference to it (a dev `undra build --platform host`, `undra bindgen`'s dlopen, the Kotlin
# runtime's `System.loadLibrary`), and the app core and undra-ffi are dependency rlibs, not this
# crate's root module. rustc links rlibs with `--start-lib` (lazy) semantics, so the macOS linker
# keeps only the objects something references -- and nothing references the core's `#[undra::api]`/
# store/port/error `inventory::submit!` statics (the schema, SPEC 2.4). An *incremental* build
# partitions those rlibs into many tiny codegen units, and the macOS linker drops the unreferenced
# ones: the core then reports the empty schema (hash 0x98754cbea76a32b2) (no `-force_load`/`-all_load`
# overrides `--start-lib`). A non-incremental build keeps them -- the same reason the release profile
# and the prelinked iOS object never showed this (ADR-029). The core's exports (`@@NAMESPACE@@_undra_api`,
# `JNI_OnLoad`) are in this crate's own root module, which is always linked (ADR-044). `undra build` compiles the host library in a target directory of its own so a
# plain `cargo build`/`cargo test` cannot leave a stripping-prone rlib for it to reuse
# (`crate::shim::host_lib_target_dir`). `undra dev` is unaffected: it serves the core from the dev
# *runner*, an executable, whose constructors always run.
[profile.dev]
incremental = false

# The profiles match the workspace's (docs/SPEC.md 7): a panic on native targets must unwind so
# the boundary can report it (constitution R6); only wasm aborts.
#
# A release build keeps the line tables of the core (ADR-046): `file:line` for every frame of a crash
# report, at no cost in the shipped code (optimisation and LTO are the same). There is no `strip` here
# on purpose: `undra build --release` strips the copies it ships and keeps the unstripped ones as the
# symbol files in build/symbols, so both are the same code. On Apple targets the build also passes
# `split-debuginfo = "unpacked"` (a profile key cannot depend on the target).
[profile.release]
lto = "fat"
codegen-units = 1
opt-level = 3
panic = "unwind"
debug = "line-tables-only"

# What `undra build --platform ios,android --release` builds (ADR-052, "native size gates"): `release` with the
# optimiser asked for size (`opt-level = "s"`: 14% off the Android library of a hello world, 16% off the playground's), except for the
# crates the call path runs through, which stay at `opt-level = 3`: on the device bench every row of `s` alone moved by up to
# 8% (and 17% of the core's own work on the host, a loop the vectoriser no longer takes up 3x), and with these four crates at
# 3 none moves by more than its noise, for about 6 points of the size (8% off a hello world, 13% off the playground; `"z"`
# would take 8 to 13 points more and slows the call path by up to half). Nothing else changes. A panic still unwinds
# (constitution R6: a panic on native is contained and reported through `catch_unwind`, which `panic = "abort"` would turn
# into a crash), the line tables stay for the symbol files of ADR-046, and the copies that ship are stripped by `undra build`
# as before. The host builds stay on `release`.
[profile.release-mobile]
inherits = "release"
opt-level = "s"
panic = "unwind"

[profile.release-mobile.package.undra-wire]
opt-level = 3

[profile.release-mobile.package.undra-signals]
opt-level = 3

[profile.release-mobile.package.undra-runtime]
opt-level = 3

[profile.release-mobile.package.undra-ffi]
opt-level = 3

# What `opt_level = "z"` in `[ios]` or `[android]` of undra.toml builds instead (ADR-052, "native size gates"): `"z"` for
# every crate, the call path included. The smallest library (arm64-v8a: 14% under `release-mobile` for a hello world, 19% for the
# playground; 22% and 29% under `release`), and a synchronous call 1.58x as slow on the Android emulator, 1.33x on the iOS simulator.
# A panic still unwinds (R6). (`opt_level = "3"` builds `release` above.)
[profile.release-mobile-z]
inherits = "release"
opt-level = "z"
panic = "unwind"

[profile.release-wasm]
inherits = "release"
opt-level = "@@WASM_OPT_LEVEL@@"
panic = "abort"

[workspace]
