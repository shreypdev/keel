load("@aspect_rules_js//js:defs.bzl", "js_test")

# `bazel test //ts:hello_test`: Node loads hello_core.wasm (undra_core, web) through the compiled bindings and calls the core.
js_test(
    name = "hello_test",
    args = ["$(rootpath //:core_web)"],
    data = [
        "//:core_web",
        "//:node_modules/@bazel-hello/core",
        "//:node_modules/@undra/runtime",
    ],
    entry_point = "hello_test.mjs",
)
