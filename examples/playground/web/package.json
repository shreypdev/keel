{
  "name": "@playground/web",
  "private": true,
  "version": "0.1.0",
  "description": "The Keel playground, web: a React and Vite UI over the one Rust core (wasm) and the generated TypeScript bindings.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.2"
  }
}
