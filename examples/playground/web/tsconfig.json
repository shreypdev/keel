{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ESNext.Disposable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@playground/core": [
        "../generated/ts/src/index.ts"
      ],
      "@keel/runtime/react": [
        "../../../runtimes/ts/@keel/runtime/src/react.ts"
      ],
      "@keel/runtime": [
        "../../../runtimes/ts/@keel/runtime/src/index.ts"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "smoke",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
