<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The playground talks to an in-memory server it carries itself, so it needs no network
	     permissions. `undra dev` serves the core over ws:// to a machine on your network; local
	     addresses are exempt from App Transport Security with this key. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to the core served by `undra dev` on your computer.</string>
	<!-- Background execution (ADR-046): UndraBootstrap registers `UndraBackground` under
	     `dev.undra.playground.undra`; the OS may then give the app a processing window and a refresh window
	     (`.processing`, `.refresh`) to replay the offline queue and refetch the cached list. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).undra.processing</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).undra.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
	</array>
</dict>
</plist>
