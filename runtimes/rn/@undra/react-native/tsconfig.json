{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.AsyncIterable",
      "ESNext.Disposable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@undra/runtime": [
        "../../../ts/@undra/runtime/src/index.ts"
      ],
      "@undra/runtime/realtime": [
        "../../../ts/@undra/runtime/src/realtime.ts"
      ],
      "@playground/core": [
        "../../../../examples/playground/generated/ts/src/index.ts"
      ],
      "vitest": [
        "./node_modules/vitest"
      ],
      "vitest/*": [
        "./node_modules/vitest/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "vitest.contract.config.ts"
  ]
}
