<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">
        <!-- An activity to move through its lifecycle with ActivityScenario (AndroidLifecycleAdapter test). -->
        <activity android:name="dev.undra.android.TestActivity" android:exported="false" />

        <!-- Writes in a process of its own, which the tests kill: what survives a process death (SecureStore, Kv). -->
        <service
            android:name="dev.undra.android.ProcessDeathService"
            android:exported="false"
            android:process=":writer" />
    </application>

</manifest>
